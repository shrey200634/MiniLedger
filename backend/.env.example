NODE_ENV=development
PORT=3000

# Must match docker-compose values (password included)
DATABASE_URL=postgresql://miniledger:CHANGE_ME_LOCAL_ONLY@localhost:5432/miniledger?schema=public
# Database name MUST end with _test (tests refuse to run otherwise)
TEST_DATABASE_URL=postgresql://miniledger:CHANGE_ME_LOCAL_ONLY@localhost:5432/miniledger_test?schema=public

# Generate: openssl rand -base64 48   (min 32 chars; placeholder below intentionally fails startup)
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN_SECONDS=86400

# Generate separately: openssl rand -base64 48
OTP_HMAC_SECRET=CHANGE_ME
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_DELIVERY=console

APP_TIMEZONE=Asia/Kolkata
DEFAULT_PHONE_REGION=IN

# Optional receipt upload (Appendix A) — ignored if feature not implemented
RECEIPT_STORAGE_DIR=./storage/receipts
RECEIPT_MAX_BYTES=5242880