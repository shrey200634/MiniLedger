generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LoanStatus {
  PENDING // declared first on purpose: ORDER BY status ASC puts PENDING before REPAID
  REPAID
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  phone     String   @unique // normalized E.164, e.g. +919876543210
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  loans     Loan[]

  @@map("users")
}

// Pre-authentication artifact: tied to a PHONE NUMBER, not to a User.
// The User row is created (upserted) only after successful verification.
model OtpChallenge {
  id            String    @id @db.Uuid // generated in app code (needed for the HMAC input)
  phone         String // normalized E.164
  codeHash      String    @map("code_hash") // HMAC-SHA256 hex; never the plain OTP
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  attempts      Int       @default(0)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(3) // set on successful verification
  invalidatedAt DateTime? @map("invalidated_at") @db.Timestamptz(3) // set when superseded or attempts exhausted
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([phone, createdAt])
  @@map("otp_challenges")
}

model Loan {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  friendName String     @map("friend_name") @db.VarChar(80)
  amount     Decimal    @db.Decimal(12, 2)
  dueDate    DateTime   @map("due_date") @db.Date // date-only
  status     LoanStatus @default(PENDING)
  repaidAt   DateTime?  @map("repaid_at") @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, dueDate])
  @@map("loans")
}